# Secret key for encrypting EmDash sessions and sensitive data.
# Generate once per deployment (e.g. `openssl rand -base64 32`) and keep it
# in the host's secret store. Never commit the real value.
EMDASH_ENCRYPTION_KEY="MY_EMDASH_ENCRYPTION_KEY"

# Public origin users type in the browser (no trailing path).
# Used for canonical URLs, JSON-LD, RSS, robots.txt and admin passkeys.
SITE_URL="https://mamdouhaboammar.com"

# Where the SQLite database and uploaded media live. In production this MUST
# be outside the deploy/build directory, or every deploy starts empty.
# Defaults to ./data.db and ./uploads when unset (local development).
# CMS_DATA_DIR="/home/<user>/domains/mamdouhaboammar.com/cms-data"

# Optional fine-grained overrides (take precedence over CMS_DATA_DIR).
# CMS_DATABASE_PATH="/srv/arabic-cms/data.db"
# CMS_UPLOADS_DIR="/srv/arabic-cms/uploads"
